FROM golang:1.26-bookworm AS build
WORKDIR /src
COPY cmd/subscription-gateway/main.go ./main.go
RUN CGO_ENABLED=0 go build -o /out/artex-subscription-gateway ./main.go

FROM node:22-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl \
    && curl -fsSL https://chatgpt.com/codex/install.sh | sh \
    && mkdir -p /tmp/codex /workspace \
    && rm -rf /var/lib/apt/lists/*
ENV PATH=/root/.local/bin:${PATH}
COPY --from=build /out/artex-subscription-gateway /usr/local/bin/artex-subscription-gateway
EXPOSE 8789
ENTRYPOINT ["artex-subscription-gateway"]
